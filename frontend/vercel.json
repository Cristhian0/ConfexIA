{
  "version": 2,
  "buildCommand": "npm run build",
  "outputDirectory": "dist/pati-confeccion",
  "rewrites": [
    {
      "source": "/api/:path*",
  
      "destination": "https://confecciones-1-ygxr.onrender.com/api/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
